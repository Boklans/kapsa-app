# =============================================================================
# KAPSA — Environment Configuration
# =============================================================================
# Якщо змінні нижче не задані, застосунок автоматично працює у повнофункціональному
# режимі демонстрації (Offline / Demo Mode) без крашів чи помилок.
#
# Для підключення до реального хмарного проекту Supabase:
# 1. Створіть проект на https://supabase.com
# 2. Виконайте міграції з папки supabase/migrations/
# 3. Скопіюйте цей файл у .env та вставте ваші ключі з Project Settings -> API
# =============================================================================

# URL вашого проекту Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Публічний анонімний ключ (anon key)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
